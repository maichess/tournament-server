# Tournament server runtime configuration.
# Copy to .env (gitignored) and fill in real values, or export these in your shell.

# HTTP listen port. Optional. Default: 8080.
PORT=8080

# HMAC-SHA256 signing key for JWT bearer tokens.
# REQUIRED in production — leaving this at the default makes signatures trivially forgeable.
# Generate a strong value with: openssl rand -hex 32
TOURNAMENT_JWT_SECRET=changeme
